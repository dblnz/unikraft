$(eval $(call addlib_s,libukrust,$(CONFIG_LIBUKRUST)))

CINCLUDES-$(CONFIG_LIBUKRUST) += -I$(LIBUKRUST_BASE)/ukrust_sys

RUSTCFLAGS-$(CONFIG_LIBUKRUST) += --extern ukrust_sys -L $(LIBUKRUST_BUILD)/ --extern alloc \
		--target $(LIBUKRUST_BASE)/target.json \
		-Zallow-features=allocator_api,bench_black_box,concat_idents,global_asm,try_reserve

export LIBUKRUST_BINDINGS_FILE=$(LIBUKRUST_BUILD)/bindings_generated.rs

ifeq ($(CONFIG_LIBUKRUST),y)
# Do not perform these if CONFIG_RUST is not set, as it is not
# guaranteed that rustc will be available in the system.
RUSTC_SYSROOT := $(shell $(RUSTC)  --print sysroot)
RUST_LIB_SRC ?= $(RUSTC_SYSROOT)/lib/rustlib/src/rust/library
endif

# Common flags
LIBUKRUST_COMMON_FLAGS = -Zunstable-options --target=$(LIBUKRUST_BASE)/target.json --emit=dep-info,obj,metadata \
	-Cpanic=abort -Cembed-bitcode=n -Clto=n -Crpath=n \
	-Cforce-unwind-tables=n -Ccodegen-units=1 \
	-Zbinary_dep_depinfo=y -Csymbol-mangling-version=v0 \
	-Dunsafe_op_in_unsafe_fn -Drust_2018_idioms \
	--crate-type rlib

# Generate rust bindings for the Unikraft API
#
# bindings_helper.h pulls in headers such as <stdarg.h> (via uk/print.h) and
# <errno.h> (via uk/alloc.h).  With -nobuiltininc clang's builtin headers are
# disabled, so even <stdarg.h> must come from the configured libc; musl provides
# these as symlinks staged during its fetch/prepare steps.  bindgen is a
# UK_PREPARE target that Make runs in parallel with library fetch/prepare, so
# without an explicit edge it can run before those headers exist and fail with
# e.g. "'stdarg.h' file not found" or "'errno.h' file not found" (proven: the
# build fails reliably without this ordering).
#
# Ordering, expressed generically (not musl-specific):
#   * nolibc provides its headers in-tree, so there is nothing to wait for.
#   * Any external libc (CONFIG_HAVE_LIBC: musl, newlib, ...) is downloaded and
#     extracted by the top-level `fetch` target; depend on it (order-only) so the
#     libc source headers exist before bindgen runs.
#   * musl additionally stages its headers as symlinks during its prepare step
#     ($(LIBMUSL_BUILD)/.prepared); wait for that too so the symlinks are valid.
# Deferred via .SECONDEXPANSION because LIBMUSL_BUILD is only defined once musl's
# Makefile.uk has been parsed.  The validation below is kept as a safety net.
$(LIBUKRUST_BUILD)/bindings_generated.rs: $(LIBUKRUST_BASE)/ukrust_sys/bindings_helper.h $(LIBUKLIBID_BUILD)/include/uk/bits/libid.h | $$(if $$(CONFIG_HAVE_LIBC),fetch) $$(if $$(CONFIG_LIBMUSL),$$(LIBMUSL_BUILD)/.prepared)
	$(call build_cmd, BINDGEN, libukrust, $(notdir $@), \
		bindgen -o $(LIBUKRUST_BUILD)/bindings_generated.rs --use-core --ctypes-prefix crate::c_types \
		--with-derive-default --no-debug '.*' --blocklist-type 'uk_arch_x86_64_seg.*' \
		$(LIBUKRUST_BASE)/ukrust_sys/bindings_helper.h -- $(CINCLUDES) \
		$(CINCLUDES-y) -nobuiltininc -DMODULE -D__LIBNAME__=libukrust -D__BASENAME__=bindings_generated.rs \
		&& grep -q '__ukrust_sys_malloc' $(LIBUKRUST_BUILD)/bindings_generated.rs \
		|| { rm -f $(LIBUKRUST_BUILD)/bindings_generated.rs; \
		     echo "ERROR: bindgen produced incomplete bindings (missing allocator symbols). Retrying may fix this."; \
		     false; })

# Build the ukrust_sys crate, contains the bindings and other useful functions.
# lib.rs -> bindings.rs include!s $(LIBUKRUST_BINDINGS_FILE) (bindings_generated.rs)
# at compile time, so bindgen must run first; list it as a prerequisite to avoid a
# parallel race that would otherwise fail with "couldn't read bindings_generated.rs".
$(LIBUKRUST_BUILD)/ukrust_sys.o: $(LIBUKRUST_BASE)/ukrust_sys/lib.rs $(LIBUKRUST_BUILD)/bindings_generated.rs $(LIBUKRUST_BUILD)/core.o $(LIBUKRUST_BUILD)/compiler_builtins.o
	$(call build_cmd, RUSTC, libukrust, $(notdir $@), \
	$(RUSTC) $(LIBUKRUST_COMMON_FLAGS) --edition=2021 --extern alloc  \
		--out-dir $(LIBUKRUST_BUILD) -L $(LIBUKRUST_BUILD) -A dead_code \
		-A unused_doc_comments --crate-name ukrust_sys $(LIBUKRUST_BASE)/ukrust_sys/lib.rs)


$(LIBUKRUST_BUILD)/alloc.o: $(RUST_LIB_SRC)/alloc/src/lib.rs $(LIBUKRUST_BUILD)/core.o $(LIBUKRUST_BUILD)/compiler_builtins.o
	$(call build_cmd, RUSTC, libukrust, $(notdir $@), \
	$(RUSTC) $(LIBUKRUST_COMMON_FLAGS) --edition=2024 \
		--out-dir $(LIBUKRUST_BUILD) -L $(LIBUKRUST_BUILD) -A dead_code \
		-A unused_doc_comments --crate-name alloc $(RUST_LIB_SRC)/alloc/src/lib.rs)

$(LIBUKRUST_BUILD)/core.o: $(RUST_LIB_SRC)/core/src/lib.rs
	$(call build_cmd, RUSTC, libukrust, $(notdir $@), \
	$(RUSTC) $(LIBUKRUST_COMMON_FLAGS) --edition=2024 \
		--out-dir $(LIBUKRUST_BUILD) -L $(LIBUKRUST_BUILD) -A dead_code \
		-A unused_doc_comments --crate-name core $(RUST_LIB_SRC)/core/src/lib.rs)

$(LIBUKRUST_BUILD)/compiler_builtins.o: $(LIBUKRUST_BASE)/compiler_builtins.rs $(LIBUKRUST_BUILD)/core.o
	$(call build_cmd, RUSTC, libukrust, $(notdir $@), \
	$(RUSTC) $(LIBUKRUST_COMMON_FLAGS) --edition=2021 \
		--out-dir $(LIBUKRUST_BUILD) -L $(LIBUKRUST_BUILD) -A dead_code \
		-A unused_doc_comments --crate-name compiler_builtins $(LIBUKRUST_BASE)/compiler_builtins.rs)

# We build these objects first because they are standalone and may be used by any rust internal library
UK_PREPARE-$(CONFIG_LIBUKRUST) += $(LIBUKRUST_BUILD)/bindings_generated.rs $(LIBUKRUST_BUILD)/ukrust_sys.o \
		 $(LIBUKRUST_BUILD)/core.o $(LIBUKRUST_BUILD)/compiler_builtins.o

UK_PREPARE-$(CONFIG_LIBUKRUST) += $(LIBUKRUST_BUILD)/alloc.o
LIBUKRUST_OBJS-y += $(LIBUKRUST_BUILD)/alloc.o

LIBUKRUST_OBJS-y += $(LIBUKRUST_BUILD)/ukrust_sys.o
LIBUKRUST_OBJS-y += $(LIBUKRUST_BUILD)/core.o
LIBUKRUST_OBJS-y += $(LIBUKRUST_BUILD)/compiler_builtins.o

LIBUKRUST_SRCS-y += $(LIBUKRUST_BASE)/rust_glue.c
